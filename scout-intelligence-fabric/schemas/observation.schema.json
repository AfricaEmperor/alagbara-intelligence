{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alagbara.example/schemas/observation.schema.json",
  "title": "SCOUT Observation",
  "type": "object",
  "required": ["observation_id", "subject", "claim", "state", "provenance"],
  "properties": {
    "observation_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "state": {"enum": ["observed", "derived", "unverified", "unknown"]},
    "captured_text": {"type": ["string", "null"]},
    "attributes": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["source_url", "observed_at", "collected_at", "collection_method", "adapter"],
      "properties": {
        "source_url": {"type": "string", "format": "uri"},
        "observed_at": {"type": "string", "format": "date-time"},
        "collected_at": {"type": "string", "format": "date-time"},
        "collection_method": {"type": "string", "minLength": 1},
        "adapter": {"type": "string", "minLength": 1},
        "raw_record_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
