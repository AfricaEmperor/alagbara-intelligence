{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alagbara.example/schemas/radar/v1/venue.schema.json",
  "title": "Radar Venue v1.0.0",
  "type": "object",
  "required": [
    "venue_id",
    "name",
    "city",
    "district",
    "address",
    "latitude",
    "longitude",
    "venue_type",
    "source_references",
    "verification_status"
  ],
  "properties": {
    "venue_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "city": {
      "const": "Cotonou"
    },
    "district": {
      "type": [
        "string",
        "null"
      ]
    },
    "address": {
      "type": [
        "string",
        "null"
      ]
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "venue_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_references": {
      "type": "array",
      "minItems": 1
    },
    "verification_status": {
      "enum": [
        "unverified",
        "candidate",
        "verified"
      ]
    }
  }
}
