{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alagbara.example/schemas/radar/v1/evidence.schema.json",
  "title": "Radar Evidence Record v1.0.0",
  "type": "object",
  "required": [
    "observation_id",
    "source_id",
    "source_platform",
    "source_url",
    "collection_method",
    "collected_at",
    "content_hash",
    "evidence_state",
    "raw_media_reference",
    "extraction_version"
  ],
  "properties": {
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence_state": {
      "enum": [
        "observed",
        "derived",
        "unverified",
        "unknown"
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
