{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "pulse_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "source_types": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_strength": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "observation_ids": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "observation_ids",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "source_types",
        "evidence_strength",
        "contradictions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "pulse_id",
    "claim",
    "evidence"
  ],
  "additionalProperties": false,
  "$id": "urn:alagbara:museops:contract:0.1.0:finding",
  "title": "MuseOps Finding"
}
