{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "signal_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_candidate": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": {}
      },
      "required": [
        "type",
        "value"
      ],
      "additionalProperties": false
    },
    "capability": {
      "type": "string",
      "enum": [
        "nlp",
        "ocr",
        "vision"
      ]
    },
    "capability_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "id",
    "signal_id",
    "claim",
    "capability",
    "capability_confidence",
    "created_at"
  ],
  "additionalProperties": false,
  "$id": "urn:alagbara:museops:contract:0.1.0:observation",
  "title": "MuseOps Observation"
}
